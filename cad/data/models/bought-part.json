{"id":"bought-part","code":"# the bought part: an 18650 battery cell, with the largest sizes its datasheet allows.\n# It is modelled only to check the fit. It is never changed and never printed.\ncell_d, cell_len = 18.4, 65.2\ngap = 0.4                               # room around the cell\nfloor = 2\naxis_z = floor + gap + cell_d / 2       # height of the middle of the cell\n\ncell = Pos(0, 0, axis_z) * Cylinder(cell_d / 2, cell_len, rotation=(0, 90, 0))\ncell.label = \"18650 cell (bought)\"\n\n# the printed part is designed around it\nwith BuildPart() as cradle:\n    Box(cell_len + 8, cell_d + 6, axis_z, align=(Align.CENTER, Align.CENTER, Align.MIN))\n    with Locations((0, 0, axis_z)):\n        Cylinder(cell_d / 2 + gap, cell_len + 2 * gap, rotation=(0, 90, 0), mode=Mode.SUBTRACT)\ncradle.part.label = \"cradle (printed)\"","view":[1.0,-1.35,0.85],"thumb":1,"states":[{"label":"The bought part","type":"3d","meshes":[{"role":"steel","pos":[32.6,-0.0,2.4,32.6,1.795,2.577,32.6,3.521,3.1,32.6,5.111,3.95,32.6,6.505,5.095,32.6,7.65,6.489,32.6,8.5,8.079,32.6,9.023,9.805,32.6,9.2,11.6,32.6,9.023,13.395,32.6,8.5,15.121,32.6,7.65,16.711,32.6,6.505,18.105,32.6,5.111,19.25,32.6,3.521,20.1,32.6,1.795,20.623,32.6,-0.0,20.8,32.6,-1.795,20.623,32.6,-3.521,20.1,32.6,-5.111,19.25,32.6,-6.505,18.105,32.6,-7.65,16.711,32.6,-8.5,15.121,32.6,-9.023,13.395,32.6,-9.2,11.6,32.6,-9.023,9.805,32.6,-8.5,8.079,32.6,-7.65,6.489,32.6,-6.505,5.095,32.6,-5.111,3.95,32.6,-3.521,3.1,32.6,-1.795,2.577,32.6,-0.0,2.4,-32.6,-0.0,2.4,-32.6,-0.0,2.4,-32.6,1.795,2.577,-32.6,3.521,3.1,-32.6,5.111,3.95,-32.6,6.505,5.095,-32.6,7.65,6.489,-32.6,8.5,8.079,-32.6,9.023,9.805,-32.6,9.2,11.6,-32.6,9.023,13.395,-32.6,8.5,15.121,-32.6,7.65,16.711,-32.6,6.505,18.105,-32.6,5.111,19.25,-32.6,3.521,20.1,-32.6,1.795,20.623,-32.6,-0.0,20.8,-32.6,-1.795,20.623,-32.6,-3.521,20.1,-32.6,-5.111,19.25,-32.6,-6.505,18.105,-32.6,-7.65,16.711,-32.6,-8.5,15.121,-32.6,-9.023,13.395,-32.6,-9.2,11.6,-32.6,-9.023,9.805,-32.6,-8.5,8.079,-